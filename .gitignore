# Regenerated by Expo on every start; its own header says not to commit it.
apps/mobile/expo-env.d.ts

# Native projects are generated by `expo prebuild` (Continuous Native
# Generation) and hold no hand edits: native config lives in app.config.ts
# and config plugins. Committing them would let the two drift apart.
apps/mobile/ios/
apps/mobile/android/

