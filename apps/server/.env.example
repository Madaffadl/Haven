# Haven server configuration.
#
#   cp .env.example .env    then fill in the three required values below.
#
# .env is gitignored. This example is the only copy that gets committed.

# --- Required -----------------------------------------------------------------

# PostgreSQL 16+ with PostGIS.
#
# Free hosted option: Neon (https://neon.tech)
#   1. Create a project. Pick the region closest to your users.
#   2. Copy the *direct* connection string: its host must NOT contain
#      "-pooler". The pooled endpoint goes through PgBouncer, which can
#      reject the statement_timeout the server sets on every connection.
#   3. Replace the "?sslmode=require&channel_binding=require" at the end with
#      "?sslmode=verify-full". The encryption is the same, but node-postgres
#      warns on every connect for "require".
#   Example: postgresql://neondb_owner:xxxx@ep-name-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=verify-full
#
# Local Docker instead (pnpm db:up): postgres://haven:haven_dev@localhost:5432/haven
DATABASE_URL=

# Redis 6+. Holds presence, rate limits and the Socket.IO adapter. Nothing in
# it is durable.
#
# Free hosted option: Upstash (https://upstash.com)
#   1. Create a Redis database in a region close to the Postgres one.
#   2. Copy the "rediss://" connection URL (two s's = TLS), the one shown for
#      redis-cli / ioredis. The REST URL and token will not work: Socket.IO
#      needs a persistent connection for pub/sub.
#   Example: rediss://default:xxxx@name-12345.upstash.io:6379
#
# Local Docker instead (pnpm db:up): redis://localhost:6379
REDIS_URL=

# Signs access tokens. Any random string of 32+ characters. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# --- Sign-in email (optional in development, required in production) ---------

# Without a key, sign-in codes are printed in the server log instead of being
# emailed: look for "sign-in code" in the `pnpm server` output. The server
# refuses to start in production without one.
#
# Free option: Resend (https://resend.com), 100 emails a day / 3,000 a month.
#   1. Create an API key ("Sending access" is enough).
#   2. Until you verify a domain you own, Resend only delivers to the email
#      address of your own Resend account. Fine for testing on yourself; to
#      send codes to anyone else, add and verify a domain under Domains and
#      set EMAIL_FROM to an address on it.
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=Haven <onboarding@resend.dev>

# --- Optional (defaults shown) ------------------------------------------------

# Set to true when deployed behind a hosting platform's proxy, so per-IP rate
# limits see real client addresses. Leave false when reached directly.
# TRUST_PROXY=false

# PORT=4000
# LOG_LEVEL=info
# DATABASE_POOL_MAX=20
# OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
